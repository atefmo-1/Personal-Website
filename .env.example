# Contact form email delivery (https://resend.com). Copy to .env.local for local testing,
# and add the same keys in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
# Optional. Defaults to the email in lib/site.ts.
CONTACT_TO_EMAIL=
# Optional. Leave empty to use Resend's test sender (only delivers to your Resend account's email).
CONTACT_FROM_EMAIL=
